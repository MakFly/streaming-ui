{
  "name": "streaming-ui",
  "private": true,
  "version": "1.0.0",
  "description": "Every way an AI response can arrive: 249 live streaming and agent patterns, 10 AI chat templates and 11 composers installable with the shadcn CLI.",
  "license": "MIT",
  "author": "Kev (MakFly)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MakFly/streaming-ui.git"
  },
  "homepage": "https://github.com/MakFly/streaming-ui#readme",
  "bugs": {
    "url": "https://github.com/MakFly/streaming-ui/issues"
  },
  "keywords": [
    "ai",
    "chat",
    "streaming",
    "llm",
    "agent",
    "react",
    "tailwindcss",
    "shadcn",
    "shadcn-registry",
    "ui-components"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && bun scripts/prerender-html.mjs",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "registry:build": "REGISTRY_URL=https://streaming-ui.pulseview.app bun scripts/build-registry.mjs",
    "registry:check": "bun run registry:build && git diff --exit-code -- registry.json registry public/r"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
